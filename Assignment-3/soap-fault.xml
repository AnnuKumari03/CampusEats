<?xml version="1.0" encoding="UTF-8"?>

<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">

    <soap:Body>

        <soap:Fault>

            <faultcode>soap:Client</faultcode>

            <faultstring>Payment could not be completed</faultstring>

            <detail>
                <errorCode>card_declined</errorCode>
                <message>Payment was declined by the payment provider.</message>
            </detail>

        </soap:Fault>

    </soap:Body>

</soap:Envelope>